{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git replace *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -fR*)",
      "Bash(rm -r -f*)",
      "Bash(rm -f -r*)",
      "Bash(rm * -rf*)",
      "Bash(rm * -fr*)",
      "Bash(npx supabase db reset*)",
      "Bash(npx supabase * db reset*)",
      "Bash(supabase db reset*)",
      "Bash(node node_modules/supabase/dist/supabase.js db reset*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git rebase*)",
      "PowerShell(git filter-branch *)",
      "PowerShell(git commit --amend*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(npx supabase db reset*)",
      "PowerShell(Get-Content *.env*)",
      "Bash(rm *.env.local*)",
      "Bash(unlink *.env.local*)",
      "Bash(git rm *.env.local*)",
      "Bash(mv *.env.local*)",
      "Bash(shred *.env.local*)",
      "Bash(truncate *.env.local*)",
      "Bash(find * -delete*)",
      "PowerShell(Remove-Item *.env.local*)",
      "PowerShell(Move-Item *.env.local*)",
      "PowerShell(Clear-Content *.env.local*)",
      "PowerShell(Set-Content *.env.local*)",
      "PowerShell(git rm *.env.local*)",
      "Read(.env.local)",
      "Read(.env.local.live-backup)",
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(npx *)",
      "Bash(npm exec *)",
      "Bash(supabase *)",
      "Bash(node node_modules/supabase/dist/supabase.js link*)",
      "Bash(node node_modules/supabase/dist/supabase.js db push*)",
      "Bash(node node_modules/supabase/dist/supabase.js * --project-ref*)",
      "Bash(node node_modules/supabase/dist/supabase.js * --db-url*)",
      "Bash(npm install*)",
      "Bash(npm i)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm uninstall*)",
      "Bash(npm remove*)",
      "Bash(npm update*)",
      "Bash(npm upgrade*)",
      "PowerShell(git push*)",
      "PowerShell(npx *)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm uninstall*)",
      "PowerShell(npm update*)",
      "Edit(/supabase/migrations/**)",
      "Edit(/.claude/settings.json)"
    ]
  }
}
